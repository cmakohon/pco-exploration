# Secrets for the Edge Functions.
# Set them on the hosted project with:
#   supabase secrets set --env-file .env
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected
# automatically; secret names may not begin with SUPABASE_.)

# From the PCO application wizard. The secret is shown only once.
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=

# REQUIRED by PCO on every API request. Must identify your app and give a way
# to reach you - a generic or missing value gets a 403.
PCO_USER_AGENT=PCO Exploration (https://example.com/contact)

# Lock CORS down to the origin serving web/index.html. Defaults to * if unset.
ALLOWED_ORIGIN=http://localhost:3000
